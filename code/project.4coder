version(2);
project_name = "marker";

patterns = {
 "*.c",
 "*.h",
 "*.bat",
 "*.sh",
 "*.glsl",
 "*.4coder"
};

blacklist_patterns = {
 ".*",
 "*.exe",
 "*.o",
 "*.rdi",
 "*.pdb",
 "build/*",
 "ext/*",
};

load_paths = {
 .win = {{ .path = "", .recursive = true, .relative = true }},
};

commands = {

 .build = {
  .win = "build.bat",
  .out = "*compilation*",
  .footer_panel = true,
  .save_dirty_files = true,
  .cursor_at_end = true,
 },

 .build_debug = {
  .win = "raddbg --ipc kill_all & build.bat && raddbg --ipc run",
  .out = "*compilation*",
  .footer_panel = true,
  .save_dirty_files = true,
  .cursor_at_end = true,
 },

 .build_run = {
  .win = "build.bat && build\marker_win32.exe",
  .out = "*compilation*",
  .footer_panel = true,
  .save_dirty_files = true,
  .cursor_at_end = true,
 },

};

fkey_command = {
 .F2 = "build",
 .F3 = "build_debug",
 .F4 = "build_run",
};